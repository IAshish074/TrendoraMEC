# =============================================================
# Fast Dockerfile for Pre-built Artifacts
# Uses host-compiled target/*.jar and frontend/dist directly
# Builds image in ~5 seconds!
# =============================================================
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx supervisor curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /etc/nginx/sites-enabled/* /etc/nginx/sites-available/*

# Copy backend JARs
COPY meccomerce/auth-service/target/auth-service-*.jar /app/auth-service.jar
COPY meccomerce/user-service/target/user-service-*.jar /app/user-service.jar
COPY meccomerce/product-service/target/product-service-*.jar /app/product-service.jar
COPY meccomerce/cart-service/target/cart-service-*.jar /app/cart-service.jar
COPY meccomerce/order-service/target/order-service-*.jar /app/order-service.jar
COPY meccomerce/inventory-service/target/inventory-service-*.jar /app/inventory-service.jar
COPY meccomerce/payment-service/target/payment-service-*.jar /app/payment-service.jar
COPY meccomerce/api-gateway/target/api-gateway-*.jar /app/api-gateway.jar

# Copy frontend static build
COPY frontend/dist/ /usr/share/nginx/html/

# Copy configurations
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Single Entry Port: Port 80
EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-n"]
